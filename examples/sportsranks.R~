
library(INLA)
library(graphpcor)

inla.setOption(
    safe = FALSE,
    num.threads = 6L
)

data(sportsranks, package = "msos")
dim(sportsranks)

## 7 variables
set.seed(1)
jj <- sample(1:ncol(sportsranks))
dat <- sportsranks[, jj]

(p <- ncol(V <- cov(dat)))
V

round(100 * cov2cor(V))

image(cov2cor(V))

lV <- chol(V)
lV

Q <- chol2inv(lV)
round(Q, 2)

## partial correlation matrix
pC <- cov2cor(cov(dat) + diag(p)*.0001)
dimnames(pC) <- dimnames(Q) <- dimnames(V) <-
    list(colnames(dat), colnames(dat))
round(pC*100)

## define a graphpcor from pC threshold
rowSums(abs(pC)>0.25)
g <- graphpcor(abs(pC)>0.25)

g
c(p, p*(p-1)/2)

par(mfrow = c(1, 1), mar = c(0,0,0,0))
plot(g)

